# Environment Configuration
ENV_NAME=development
PORT=3001
LOCAL=true

# Application URL
URL=http://localhost:3001

# Phone number encryption (AES-256-GCM with key rotation)
# Generate each key with: openssl rand -hex 32
# To rotate: add PHONE_ENC_KEY_{n+1}, bump PHONE_ENC_KEY_VERSION — old records still decrypt.
PHONE_ENC_KEY_VERSION=1
PHONE_ENC_KEY_1=

# Google Sign-In (Android)
# From Google Cloud Console → OAuth 2.0 Client IDs → Android client ID
GOOGLE_CLIENT_ID=

# Contact-us notification email (sent via AWS SES using the AWS_* credentials above)
SES_FROM_EMAIL=info@winky.com

# Inbox that receives contact-us submissions
SUPPORT_NOTIFICATION_EMAIL=info@winky.com

# ── OTP request credentials ───────────────────────────────────────────────────
# The mobile app signs each OTP request with HMAC-SHA256 over `phone:minute` and
# sends OTP_CLIENT_KEY_CODE as a header. Both values ship inside the app binary and
# are recoverable from the IPA — they are not secrets from an attacker who has the
# app, and the rate limits below are what actually cap SMS spend.
#
# Generate a new pair with: npm run otp:gen-secret
# Must match Config/Secrets.xcconfig in the iOS repo.
#
# Leaving OTP_SIGNATURE_SECRET unset makes the endpoint fail closed with a 503,
# rather than silently falling back to the keyless legacy SHA1 signature.
OTP_SIGNATURE_SECRET=
OTP_CLIENT_KEY_CODE=

# Rotation: set these to the values being replaced so old app builds keep working
# while a release rolls out. Logs warn "matched a RETIRING" whenever one is used —
# when that stops, remove these. The rotation is not complete until you do.
# OTP_SIGNATURE_SECRET_RETIRING=
# OTP_CLIENT_KEY_CODE_RETIRING=

# Accept the pre-HMAC SHA1 signature, which contains no secret at all. Only for
# draining traffic from very old builds; leave unset.
# OTP_ALLOW_LEGACY_SIGNATURE=true

# ── OTP abuse limits ──────────────────────────────────────────────────────────
# Defaults shown. These are the real protection on the endpoint: per-phone stops a
# victim being SMS-bombed, per-IP stops one origin rotating through many numbers,
# and the global budget is the backstop on Twilio spend.
# OTP_MAX_PER_PHONE_PER_HOUR=5
# OTP_MAX_PER_PHONE_PER_10MIN=3
# OTP_MAX_PER_IP_PER_HOUR=20
# OTP_GLOBAL_HOURLY_LIMIT=2000
